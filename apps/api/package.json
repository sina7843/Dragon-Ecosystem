{
  "name": "@dragon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test \"src/**/*.itest.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node src/migrate.ts",
    "seed:demo": "node src/seed-demo.ts",
    "seed:demo:reset": "node src/seed-demo.ts --reset --confirm",
    "bootstrap:superadmin": "node src/bootstrap-superadmin.ts",
    "dev": "node --watch src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.2.0",
    "mongodb": "^6.21.0",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.1"
  }
}
