{
  "name": "dragon-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Dragon Ecosystem — esports news and tournament platform.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node scripts/wait-for-test-db.mjs && npm run test:integration --workspace @dragon/api",
    "test:budget": "npm run test:budget --workspace apps/web",
    "closure:check": "node --test scripts/closure-check.test.mjs",
    "decision:check": "node --test scripts/release-decision.test.mjs",
    "ci:validate": "node scripts/ci-validate.mjs",
    "ci": "npm run ci:validate && npm run typecheck && npm run lint && npm test && npm run build && npm run test:budget && npm run closure:check && npm run decision:check",
    "ci:full": "npm run ci && npm run test:integration && npm run verify:migrations && npm run e2e",
    "verify:migrations": "node scripts/wait-for-test-db.mjs && node scripts/verify-migrations.mjs",
    "seed:demo": "npm run seed:demo --workspace @dragon/api",
    "seed:demo:reset": "npm run seed:demo:reset --workspace @dragon/api",
    "build": "npm run build --workspaces --if-present",
    "e2e": "node scripts/wait-for-test-db.mjs && node scripts/reset-test-db.mjs && npm run build && npm run e2e --workspace apps/web",
    "migrate": "npm run migrate --workspace @dragon/api",
    "db:test:up": "node scripts/wait-for-test-db.mjs",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "verify:persistence": "node scripts/mongo-persistence-check.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:stop": "docker compose stop",
    "inventory": "node scripts/extract-inventory.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
