# Copy this file to .env only when the implementation introduces the variables.
# Never commit real credentials.
# Full reference, including secret status and rotation: ENVIRONMENT_VARIABLES.md

# --- API runtime ---
NODE_ENV=development
# Containers must bind all interfaces; the published surface is controlled by Compose.
HOST=0.0.0.0
PORT=3000
# MongoDB is reachable only on the internal Compose network. Host port 27017 is never published.
# This default applies outside production; production startup fails when the value is missing.
# The replica set is required: MongoDB only supports transactions on one.
MONGODB_URI=mongodb://mongo:27017/dragon?replicaSet=rs0

# --- Authentication (identity module) ---
# Keys OTP-code and session-token hashes. REQUIRED and secret in production; must
# be at least 32 characters. Never commit a real value. Rotating it invalidates
# existing sessions and pending codes.
AUTH_SECRET=development-only-insecure-auth-secret
# OTP and session security settings (section 16.1). Defaults are applied when unset.
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_MOBILE=5
OTP_REQUESTS_PER_IP=20
OTP_WINDOW_SECONDS=900
SESSION_TTL_HOURS=336
RECENT_AUTH_MINUTES=15

# --- Local web tooling ---
# Origin the Vite dev/preview proxy forwards /api to when running outside containers.
API_PROXY_TARGET=http://127.0.0.1:3000

# --- Automated tests ---
# Disposable database started by docker-compose.test.yml. Never point this at real data.
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/?directConnection=true
